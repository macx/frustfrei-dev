---
import { Icon } from 'astro-icon/components'

interface Props {
  title: string
  icon?: string
}

const { title, icon } = Astro.props
---

<article class='card'>
  <p class='card-title'>
    {icon && <Icon name={icon} />}
    {title}
  </p>
  <div class='card-body'>
    <slot />
  </div>
</article>

<style>
  .card {
    border: 1px solid var(--clr-line);
    border-radius: var(--radius);
    padding: var(--sp);
    background-color: var(--clr-bg-card);
  }

  .card-title {
    display: flex;
    align-items: center;
    gap: 0.6em;
    margin-block: 0 0.5em;
    font-weight: var(--fw-strong);
    font-size: var(--fs-l);
  }

  .card-body {
    & > :first-child {
      margin-block-start: 0;
    }

    & > :last-child {
      margin-block-end: 0;
    }
  }
</style>
