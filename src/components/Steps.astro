---
// Adapted from Starlight's <Steps>: a numbered bullet + centered guideline.
// Does NOT render its own <ol> — the slotted Markdown numbered list already
// produces one, and wrapping it in a second <ol> caused double nesting
// (the inner, unstyled <ol> kept re-matching the site's global list rule
// independently of any class set on our outer wrapper).
---

<div class='steps'>
  <slot />
</div>

<style is:global>
  .content .steps ol {
    /* Neutralizes the global ol rule at its source: both its own
       padding-inline-start and the li::before negative-margin trick read
       from this same variable. */
    --padding-inline: 0;

    --bullet-size: 1.75rem;
    --bullet-margin: 0.375rem;
    --guide-width: 1px;

    margin-block: var(--sp) var(--sp-l);
    list-style: none;
    counter-reset: steps-counter;

    li {
      position: relative;
      counter-increment: steps-counter;
      padding-inline-start: calc(var(--bullet-size) + 1rem);
      padding-block-end: var(--sp-s);
      margin-block-end: 0;
      min-block-size: calc(var(--bullet-size) + var(--bullet-margin));
    }

    li + li {
      margin-block-start: 0;
    }

    li::before {
      content: counter(steps-counter);
      position: absolute;
      inset-block-start: 0;
      inset-inline-start: 0;

      display: grid;
      place-items: center;
      inline-size: var(--bullet-size);
      block-size: var(--bullet-size);
      border-radius: 999px;

      background-color: var(--clr-primary);
      color: #fff;
      font-size: var(--fs-xs);
      font-weight: var(--fw-bold);
      line-height: 1;
    }

    li::after {
      content: '';
      position: absolute;
      inset-block-start: calc(var(--bullet-size) + var(--bullet-margin));
      inset-block-end: var(--bullet-margin);
      inset-inline-start: calc((var(--bullet-size) - var(--guide-width)) / 2);
      inline-size: var(--guide-width);
      background-color: var(--clr-line);
    }

    li:last-child::after {
      content: none;
    }

    li > :first-child {
      margin-block-start: 0;
    }

    li > :last-child {
      margin-block-end: 0;
    }
  }
</style>
