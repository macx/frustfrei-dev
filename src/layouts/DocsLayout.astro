---
import BaseLayout from './BaseLayout.astro'
import SectionNav from '@components/SectionNav.astro'
import TableOfContent from '@components/TableOfContents.astro'
import { starterkitNav } from '../data/section-nav/starterkit.ts'

const sectionNavRegistry: Record<
  string,
  { label: string; groups: typeof starterkitNav }
> = {
  starterkit: { label: 'Starterkit', groups: starterkitNav }
}

const { headings } = Astro.props
const { title, description, toc, sectionNav } =
  Astro.props.frontmatter || Astro.props
const section = sectionNav ? sectionNavRegistry[sectionNav] : undefined
---

<BaseLayout frontmatter={{ title, description }} layout='docs' toc={false}>
  <div class='docs-stage'>
    {section && <SectionNav label={section.label} groups={section.groups} />}

    <div class='docs-content'>
      <slot />
    </div>

    {
      toc && headings && (
        <div class='docs-toc'>
          <TableOfContent headings={headings} />
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  :global(.content.docs) {
    flex: 1 1 auto;
    max-width: none;
    margin-inline: 0;
  }

  .docs-stage {
    display: grid;
    gap: var(--sp);
    width: 100%;

    @media screen and (width >= 57.5em) {
      grid-template-columns: 15rem minmax(0, var(--content-max-width));
      justify-content: center;
      gap: var(--sp-l);
    }

    @media screen and (width >= 80em) {
      grid-template-columns: 15rem minmax(0, var(--content-max-width)) 15rem;
    }
  }

  .docs-stage > :global(.section-nav-aside) {
    @media screen and (width >= 57.5em) {
      grid-column: 1;
      grid-row: 1;
      align-self: start;
    }
  }

  .docs-content {
    min-width: 0;
    width: 100%;
    max-width: var(--content-max-width);

    @media screen and (width >= 57.5em) {
      grid-column: 2;
      grid-row: 1;
    }
  }

  .docs-stage > :global(.section-nav-aside),
  .docs-toc {
    font-size: var(--fs);
  }

  .docs-toc {
    :global(aside) {
      height: 100%;
    }

    @media screen and (57.5em <= width < 80em) {
      grid-column: 1 / -1;
      grid-row: 2;
      position: relative;
      z-index: 3;
      background-color: var(--clr-bg);

      :global(.toc) {
        position: static;
        max-block-size: none;
        overflow-y: visible;
        padding-inline-start: 0;

        & :global(.button) {
          display: inline-flex !important;
        }
      }

      :global(.toc-list) {
        &.hidden-l {
          max-height: 0;
          overflow: hidden;
        }
      }

      :global(.toc-progress) {
        display: none;
      }
    }

    @media screen and (width >= 80em) {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
