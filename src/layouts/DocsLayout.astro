---
import BaseLayout from './BaseLayout.astro'
import SectionNav from '@components/SectionNav.astro'
import TableOfContent from '@components/TableOfContents.astro'
import PageNav from '@components/PageNav.astro'
import { getSectionNav, getAdjacentPages } from '../utils/docsNav.ts'

const { headings } = Astro.props
const { title, description, toc, sectionNav } =
  Astro.props.frontmatter || Astro.props
const section = sectionNav ? getSectionNav(sectionNav) : undefined
const adjacentPages = sectionNav
  ? getAdjacentPages(sectionNav, Astro.url.pathname)
  : undefined
---

<BaseLayout frontmatter={{ title, description }} layout='docs' toc={false}>
  <div class='docs-stage'>
    <div class='docs-mobile-bar'>
      {section && <SectionNav label={section.label} groups={section.groups} />}

      {
        toc && headings && (
          <div class='docs-toc'>
            <TableOfContent headings={headings} />
          </div>
        )
      }
    </div>

    <div class='docs-content'>
      <slot />

      {adjacentPages && <PageNav prev={adjacentPages.prev} next={adjacentPages.next} />}
    </div>
  </div>
</BaseLayout>

<style>
  :global(.content.docs) {
    flex: 1 1 auto;
    max-width: none;
    margin-inline: 0;
  }

  .docs-stage {
    display: grid;
    gap: var(--sp);
    width: 100%;

    @media screen and (width >= 57.5em) {
      grid-template-columns: 15rem minmax(0, var(--content-max-width));
      justify-content: center;
      gap: var(--sp-m) var(--sp-l);
    }

    @media screen and (width >= 80em) {
      grid-template-columns: 15rem minmax(0, var(--content-max-width)) 15rem;
    }
  }

  .docs-mobile-bar {
    display: contents;

    @media screen and (width < 57.5em) {
      display: grid;
      grid-template-columns: 2.5rem 1fr;
      column-gap: var(--sp-s);
      position: sticky;
      inset-block-start: var(--header-height);
      z-index: 3;

      margin-inline: calc(-1 * var(--sp-content));
      margin-block-start: calc(-1 * var(--sp-l));
      padding-inline: var(--sp-content);
      background-color: var(--clr-bg);

      :global(.section-nav-aside),
      :global(.section-nav),
      .docs-toc,
      :global(.toc-aside),
      :global(.toc) {
        display: contents;
      }

      :global(.nav-title) {
        grid-column: 1;
        grid-row: 1;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      :global(.toc-compact) {
        grid-column: 2;
        grid-row: 1;
        border-block-end: none;
      }

      :global(.nav-body) {
        grid-column: 1 / -1;
        grid-row: 2;
      }

      &::after {
        content: '';
        grid-column: 1 / -1;
        grid-row: 1;
        align-self: end;
        block-size: 1px;
        background-color: var(--clr-line);
      }
    }
  }

  .docs-mobile-bar :global(.section-nav-aside) {
    @media screen and (57.5em <= width < 80em) {
      grid-column: 1;
      grid-row: 1 / 3;
      align-self: start;
    }

    @media screen and (width >= 80em) {
      grid-column: 1;
      grid-row: 1;
      align-self: start;
    }
  }

  .docs-content {
    min-width: 0;
    width: 100%;
    max-width: var(--content-max-width);
    container-type: inline-size;

    @media screen and (57.5em <= width < 80em) {
      grid-column: 2;
      grid-row: 2;
    }

    @media screen and (width >= 80em) {
      grid-column: 2;
      grid-row: 1;
    }
  }

  .docs-mobile-bar :global(.section-nav-aside),
  .docs-toc {
    font-size: var(--fs);
  }

  .docs-toc {
    @media screen and (width < 80em) {
      :global(.toc-compact) {
        display: flex;
      }

      :global(.toc-title),
      :global(.toc-list),
      :global(.toc-progress) {
        display: none;
      }
    }

    @media screen and (57.5em <= width < 80em) {
      position: sticky;
      z-index: 3;
      inset-block-start: var(--header-height);
      padding-block-start: var(--sp-s);
      margin-block-start: calc(-1 * var(--sp-s));

      :global(.toc-aside) {
        margin-inline: calc(var(--sp) * -1);
        padding-inline: var(--sp);
        background-color: var(--clr-bg);
        margin-block-start: calc(-1 * var(--sp-s));
      }
    }

    @media screen and (57.5em <= width < 80em) {
      grid-column: 2;
      grid-row: 1;
    }

    @media screen and (width >= 80em) {
      grid-column: 3;
      grid-row: 1;

      :global(.toc-aside) {
        height: 100%;
      }
    }
  }
</style>
