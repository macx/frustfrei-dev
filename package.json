{
  "name": "frustfrei-dev",
  "type": "module",
  "version": "4.0.0",
  "browserslist": "> 2%, last 2 versions, not dead",
  "repository": "git@github.com:macx/frustfrei-dev.git",
  "author": "David Eiken <macx@macx.io>",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev --watch",
    "start": "astro dev",
    "build": "astro check && tsc --noEmit && astro build",
    "check-links": "lychee --config .lychee.toml --remap 'https://frustfrei.dev file://$PWD/dist' './dist/**/*.html'",
    "preview": "astro preview",
    "astro": "astro",
    "validate": "astro check",
    "test": "cypress run",
    "test:ui": "cypress open",
    "lint": "prettier --write --plugin-search-dir=. .",
    "release": "pnpm lint && pnpm build && pnpm check-links && GITHUB_TOKEN=$(gh auth token) release-it",
    "postinstall": "playwright install chromium"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@astropub/md": "^1.0.0",
    "@beoe/cache": "^0.1.1",
    "@beoe/rehype-mermaid": "^0.4.2",
    "@fontsource-variable/domine": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@iconify-json/material-symbols": "^1.2.93",
    "@iconify-json/simple-icons": "^1.2.97",
    "@playwright/test": "^1.63.0",
    "add": "^2.0.9",
    "astro": "7.3.5",
    "astro-embed": "^0.14.0",
    "astro-icon": "^1.2.0",
    "astro-link": "^1.2.1",
    "astro-og-canvas": "^0.13.2",
    "canvaskit-wasm": "^0.42.0",
    "chart.js": "^4.5.1",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-string": "^3.0.1",
    "hastscript": "^9.0.1",
    "install": "^0.13.0",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0",
    "rehype": "^13.0.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-expressive-code": "^0.44.2",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "remark-definition-list": "^2.0.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "cypress": "^16.1.0",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.9",
    "prettier-config-standard": "^7.0.0",
    "prettier-plugin-astro": "^1.1.0"
  },
  "packageManager": "pnpm@11.5.0"
}
